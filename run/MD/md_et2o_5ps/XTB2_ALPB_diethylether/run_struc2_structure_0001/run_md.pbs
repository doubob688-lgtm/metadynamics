#!/bin/bash
# Run one generated ORCA MD task in its method-structure directory.
#PBS -N md_4_1
#PBS -l walltime=23:00:00
#PBS -l select=1:ncpus=128:mpiprocs=128:mem=384gb
#PBS -o /rds/general/user/bd924/home/metadynamics/run/MD/md_et2o_5ps/XTB2_ALPB_diethylether/run_struc2_structure_0001/hpc_log/pbs.out
#PBS -e /rds/general/user/bd924/home/metadynamics/run/MD/md_et2o_5ps/XTB2_ALPB_diethylether/run_struc2_structure_0001/hpc_log/pbs.err

set -euo pipefail

module load tools
module load ORCA/6.1.1-gompi-2024a-avx2
module load gompi/2024a

export OMP_STACKSIZE=4G

cd "$PBS_O_WORKDIR"
/sw-eb/software/ORCA/6.1.1-gompi-2024a-avx2/bin/orca run_md.inp > run_md.out
