#!/bin/bash
# Run one generated ORCA MD task in its method-structure directory.
#PBS -N md_2_3
#PBS -l walltime=23:00:00
#PBS -l select=1:ncpus=64:mem=192gb
#PBS -o /mnt/c/Users/Bobdo/diazirine/run/MD/md_et2o/M06-2X_D3_0_def2-SVP_CPCM_diethylether/run_struc4_structure_0001/hpc_log/pbs.out
#PBS -e /mnt/c/Users/Bobdo/diazirine/run/MD/md_et2o/M06-2X_D3_0_def2-SVP_CPCM_diethylether/run_struc4_structure_0001/hpc_log/pbs.err

set -euo pipefail

module load tools
module load ORCA/6.1.1-gompi-2024a-avx2
module load gompi/2024a

export OMP_STACKSIZE=4G

cd "$PBS_O_WORKDIR"
/sw-eb/software/ORCA/6.1.1-gompi-2024a-avx2/bin/orca run_md.inp > run_md.out
